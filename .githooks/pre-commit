#!/usr/bin/env bash
# Pre-commit gate — enforces the "sacred substance" + plan-lint rules locally,
# before they reach CI (issues #15 / #19). Mirrors scripts/ci_checks.sh but compares
# the working tree to HEAD (the commit being made) instead of a base branch.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Override for a commit:    git commit --no-verify
#
# Calls the python checks directly (no make/just dependency) so it is robust.
set -uo pipefail
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

# Feature dirs (work/* and examples/*) with staged changes.
features=$(git diff --cached --name-only -- work/ examples/ 2>/dev/null \
  | sed -E 's@^(work|examples)/([^/]+)/.*@\1/\2@' | sort -u)

[ -z "$features" ] && exit 0

rc=0
for feat in $features; do
  [ -d "$feat" ] || continue  # feature fully deleted in this commit
  if [ -f "$feat/spec.md" ]; then
    python3 scripts/content_guard.py --git "$feat/spec.md" || rc=1
  fi
  if [ -f "$feat/design.md" ]; then
    python3 scripts/content_guard.py --git "$feat/design.md" || rc=1
  fi
  if [ -f "$feat/tasks.md" ]; then
    # --validate returns before the fail-closed secret check, so no secret needed.
    python3 scripts/orchestrate.py "$feat" --validate || rc=1
  fi
done

if [ $rc -ne 0 ]; then
  echo "⛔ pre-commit: content_guard / plan-lint failed (see above)." >&2
  echo "   Bump 'version:' for a substance change, fix the plan errors, or override with 'git commit --no-verify'." >&2
fi
exit $rc
