{
  "permissions": {
    "deny": [
      "Write(**/.approvals/**)",
      "Edit(**/.approvals/**)",
      "MultiEdit(**/.approvals/**)",
      "NotebookEdit(**/.approvals/**)",
      "Write(**/.runs/**)",
      "Edit(**/.runs/**)",
      "MultiEdit(**/.runs/**)",
      "NotebookEdit(**/.runs/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/post_edit.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/eval_gate.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/eval_gate.sh" }
        ]
      }
    ]
  }
}
